{
  "name": "2bee.app-web",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.browser.json --noEmit",
    "build": "npm run shop && npm run typecheck && vite build",
    "preview": "vite preview --port 4173",
    "test:e2e": "playwright test",
    "test:node": "node --import ./tests/register.mjs --test tests/*.test.ts",
    "gate:ts": "node tests/ts-gate.mjs",
    "wasm": "cargo build --manifest-path ../Cargo.toml -p twobee-cam-wasm --target wasm32-unknown-unknown --release && wasm-bindgen --target web --out-dir src/wasm --no-typescript ../target/wasm32-unknown-unknown/release/twobee_cam_wasm.wasm",
    "dev:fresh": "npm run wasm && npm run shop && npm run dev",
    "gate": "node ../gates/slicer_gate_check.mjs",
    "shop": "node --import ./tests/register.mjs scripts/build-shop-catalogue.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.47.0",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^5.4.11"
  }
}
